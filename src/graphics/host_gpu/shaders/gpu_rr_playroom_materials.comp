#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D base_source;
layout(binding=1) uniform sampler2D material_source;
layout(binding=2) uniform sampler2D normal_source;
layout(binding=3) uniform sampler2D depth_source;
layout(binding=4, rgba16f) writeonly uniform image2D diffuse_output;
layout(binding=5, rgba16f) writeonly uniform image2D specular_output;
layout(binding=6, rgba16f) writeonly uniform image2D normal_output;
layout(binding=7, std140) uniform Camera {
    // Guest row-major rows are uploaded as GLSL columns: matrix * vector
    // reproduces the guest's row-vector multiplication.
    mat4 inverse_projection;
    mat4 view_to_world;
    vec4 camera_position;
    uvec4 extent;
} camera;
bool finite4(vec4 v) { return !any(isnan(v)) && !any(isinf(v)); }

// NVIDIA ProgrammingGuideDLSS_RR.md 4.2.1 / Ray Tracing Gems chapter 32.
vec3 specularAlbedo(vec3 f0, float roughness, float NoV) {
    float n=clamp(abs(NoV),0.0,1.0), a=roughness*roughness;
    vec4 X=vec4(1.0,n,n*n,n*n*n), Y=vec4(1.0,a,a*a,a*a*a);
    float bias=(dot(vec2(0.99044,-1.28514),X.xy)*Y.x+
                dot(vec2(1.29678,-0.755907),X.xy)*Y.y) /
               (dot(vec3(1.0,2.92338,59.4188),X.xyw)*Y.x+
                dot(vec3(20.3225,-27.0302,222.592),X.xyw)*Y.y+
                dot(vec3(121.563,626.13,316.627),X.xyw)*Y.w);
    float scale=(dot(vec2(0.0365463,3.32707),X.xy)*Y.x+
                 dot(vec2(9.0632,-9.04756),X.xy)*Y.y) /
                (dot(vec3(1.0,3.59685,-1.36772),X.xzw)*Y.x+
                 dot(vec3(9.04401,-16.3174,9.22949),X.xzw)*Y.y+
                 dot(vec3(5.56589,19.7886,-20.2123),X.xzw)*Y.w);
    bias*=clamp(f0.g*50.0,0.0,1.0);
    return f0*max(scale,0.0)+max(bias,0.0);
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(uvec2(p),camera.extent.xy)))return;
    vec4 base=texelFetch(base_source,p,0), material=texelFetch(material_source,p,0);
    vec4 normal=texelFetch(normal_source,p,0);
    float depth=texelFetch(depth_source,p,0).r;
    vec2 uv=(vec2(p)+0.5)/vec2(camera.extent.xy);
    vec4 view=camera.inverse_projection*vec4(2.0*uv.x-1.0,1.0-2.0*uv.y,depth,1.0);
    // Unused channels can hold packed flags; they are not material-guide data.
    bool valid=finite4(vec4(base.rgb,0))&&finite4(vec4(material.rg,0,0))&&finite4(vec4(normal.xyz,0))&&finite4(view)&&
        !isnan(depth)&&!isinf(depth)&&depth>=0.0&&depth<=1.0&&abs(view.w)>1e-8&&
        all(greaterThanEqual(base.rgb,vec3(0)))&&all(lessThanEqual(base.rgb,vec3(1)))&&
        all(greaterThanEqual(material.rg,vec2(0)))&&all(lessThanEqual(material.rg,vec2(1)));
    vec4 world=camera.view_to_world*vec4(view.xyz/view.w,1.0);
    vec3 N=mat3(camera.view_to_world)*normal.xyz;
    // Orthographic rays can be sheared/jittered; derive their parallel
    // direction from the inverse projection rather than assuming camera +Z.
    vec3 V=camera.extent.z!=0u?-mat3(camera.view_to_world)*camera.inverse_projection[2].xyz:
        camera.camera_position.xyz-world.xyz;
    float nn=dot(N,N), vv=dot(V,V);
    valid=valid&&finite4(world)&&finite4(vec4(N,nn))&&finite4(vec4(V,vv))&&nn>1e-12&&vv>1e-12;
    vec3 diffuse=vec3(0), specular=vec3(0); vec4 guide=vec4(0);
    if(valid) {
        N*=inversesqrt(nn); V*=inversesqrt(vv);
        // PPSA01325 5DF28D2058CAF728: F0 at 2D4..2E4,
        // diffuse = base*(1-metallic) at 1F90..1FC8.
        float metallic=material.r, roughness=material.g;
        diffuse=base.rgb*(1.0-metallic);
        vec3 f0=mix(vec3(0.05),base.rgb,metallic);
        specular=specularAlbedo(f0,roughness,dot(N,V));
        guide=vec4(N,roughness);
        valid=finite4(vec4(specular,1.0));
    }
    // Alpha is a validity mask on albedo outputs. A caller must verify coverage;
    // invalid pixels are not silently certified as valid material inputs.
    imageStore(diffuse_output,p,valid?vec4(diffuse,1):vec4(0));
    imageStore(specular_output,p,valid?vec4(specular,1):vec4(0));
    imageStore(normal_output,p,valid?guide:vec4(0));
}
